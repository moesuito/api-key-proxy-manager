# =======================================================
# NVIDIA NIM API KEYS
# Você pode registrar suas chaves em linhas individuais:
# =======================================================
NVIDIA_API_KEY_1=nvapi-sua-key-1
NVIDIA_API_KEY_2=nvapi-sua-key-2
NVIDIA_API_KEY_3=nvapi-sua-key-3

# Ou se preferir, pode passar em uma única variável separando por vírgulas ou quebras de linha:
# NVIDIA_API_KEYS=nvapi-sua-key-1,nvapi-sua-key-2

# Modelo Padrão a ser utilizado em todas as chamadas
DEFAULT_MODEL=z-ai/glm-5.2

# URL Base da NVIDIA NIM API (compatível com OpenAI)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Intervalo em segundos para sondar se uma chave em Rate Limit (429) voltou a responder 200
PROBE_INTERVAL_SECONDS=30

# Configurações do servidor Proxy
HOST=0.0.0.0
PORT=8000
