# =======================================================
# NVIDIA NIM API KEYS
# You can register keys in individual numbered lines:
# =======================================================
NVIDIA_API_KEY_1=nvapi-your-key-1
NVIDIA_API_KEY_2=nvapi-your-key-2
NVIDIA_API_KEY_3=nvapi-your-key-3

# Or if you prefer, pass comma-separated keys in a single variable:
# NVIDIA_API_KEYS=nvapi-your-key-1,nvapi-your-key-2

# Fixed Default Model
DEFAULT_MODEL=z-ai/glm-5.2

# NVIDIA NIM Base URL (OpenAI Compatible)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Interval in seconds to probe if a rate-limited key (429) has recovered (200 OK)
PROBE_INTERVAL_SECONDS=30

# Proxy Server Settings
HOST=0.0.0.0
PORT=43100

# Fixed Proxy Master API Key (Auto-generated on first startup if omitted)
# PROXY_API_KEY=sk-nim-...
